<Window x:Class="Reclaim.Desktop.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reclaim" Width="400" SizeToContent="Height" ResizeMode="NoResize" Icon="Assets/Reclaim.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="InfoText" Style="{StaticResource Sub}" Margin="0,0,0,16"/>

        <StackPanel x:Name="Row1" Margin="0,0,0,12">
            <TextBlock x:Name="Label1" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="Box1" Style="{StaticResource PasswordInput}" MaxLength="64"/>
        </StackPanel>
        <StackPanel x:Name="Row2" Margin="0,0,0,12">
            <TextBlock x:Name="Label2" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="Box2" Style="{StaticResource PasswordInput}" MaxLength="64"/>
        </StackPanel>
        <StackPanel x:Name="Row3" Margin="0,0,0,12">
            <TextBlock x:Name="Label3" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="Box3" Style="{StaticResource PasswordInput}" MaxLength="64"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Hủy" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,10,0" MinWidth="80"/>
            <Button x:Name="OkButton" Content="Xác nhận" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110"
                    Click="OkButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
