<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Directory.Build.props đặt OutDir chung vào build\Release (nơi trình cài đặt lấy file). Test phải ra chỗ khác,
         nếu không xunit và DLL test sẽ lọt vào ReclaimSetup.exe. -->
    <OutDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="..\Reclaim.Core\Reclaim.Core.csproj" />
  </ItemGroup>

</Project>
